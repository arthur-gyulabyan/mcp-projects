{
  "$schema": "https://app.qlerify.com/schemas/domain-model/v1.json",
  "version": 1,
  "boundedContext": "Shopping Cart",
  "roles": [
    "Customer",
    "Cart Service",
    "Product Service",
    "Inventory Service"
  ],
  "domainEvents": {
    "CartCreated": {
      "event": "Cart Created",
      "role": "Customer",
      "follows": [
        "start"
      ],
      "command": {
        "$ref": "#/schemas/commands/CreateCart"
      },
      "aggregateRoot": {
        "$ref": "#/schemas/entities/Cart"
      },
      "readModels": [
        {
          "$ref": "#/schemas/queries/GetCartByCustomerID",
          "array": true
        }
      ]
    },
    "ProductDetailsFetched": {
      "event": "Product Details Fetched",
      "role": "Product Service",
      "follows": [
        {
          "$ref": "#/domainEvents/CartCreated"
        }
      ],
      "command": {
        "$ref": "#/schemas/commands/FetchProductDetails"
      },
      "aggregateRoot": {
        "$ref": "#/schemas/entities/CartItem"
      }
    },
    "ItemAddedToCart": {
      "event": "Item Added to Cart",
      "role": "Cart Service",
      "follows": [
        {
          "$ref": "#/domainEvents/ProductDetailsFetched"
        }
      ],
      "command": {
        "$ref": "#/schemas/commands/AddItemToCart"
      },
      "aggregateRoot": {
        "$ref": "#/schemas/entities/CartItem"
      },
      "readModels": [
        {
          "$ref": "#/schemas/queries/GetCartDetails"
        }
      ]
    },
    "ItemQuantityUpdated": {
      "event": "Item Quantity Updated",
      "role": "Cart Service",
      "follows": [
        {
          "$ref": "#/domainEvents/ItemAddedToCart"
        }
      ],
      "command": {
        "$ref": "#/schemas/commands/UpdateItemQuantity"
      },
      "aggregateRoot": {
        "$ref": "#/schemas/entities/CartItem"
      },
      "readModels": [
        {
          "$ref": "#/schemas/queries/GetCartDetails"
        }
      ]
    },
    "ItemRemovedFromCart": {
      "event": "Item Removed from Cart",
      "role": "Cart Service",
      "follows": [
        {
          "$ref": "#/domainEvents/ItemQuantityUpdated"
        }
      ],
      "command": {
        "$ref": "#/schemas/commands/RemoveItemFromCart"
      },
      "aggregateRoot": {
        "$ref": "#/schemas/entities/CartItem"
      },
      "readModels": [
        {
          "$ref": "#/schemas/queries/GetCartDetails"
        }
      ]
    },
    "CouponApplied": {
      "event": "Coupon Applied",
      "role": "Cart Service",
      "group": "Promotions",
      "follows": [
        {
          "$ref": "#/domainEvents/ItemRemovedFromCart"
        }
      ],
      "command": {
        "$ref": "#/schemas/commands/ApplyCoupon"
      },
      "aggregateRoot": {
        "$ref": "#/schemas/entities/Cart"
      },
      "readModels": [
        {
          "$ref": "#/schemas/queries/GetCartDetails"
        }
      ]
    },
    "CartTotalsRecalculated": {
      "event": "Cart Totals Recalculated",
      "role": "Cart Service",
      "follows": [
        {
          "$ref": "#/domainEvents/CouponApplied"
        }
      ],
      "command": {
        "$ref": "#/schemas/commands/RecalculateCartTotals"
      },
      "aggregateRoot": {
        "$ref": "#/schemas/entities/Cart"
      },
      "readModels": [
        {
          "$ref": "#/schemas/queries/GetCartSummary"
        }
      ]
    },
    "CheckoutInitiated": {
      "event": "Checkout Initiated",
      "role": "Customer",
      "group": "Checkout",
      "follows": [
        {
          "$ref": "#/domainEvents/CartTotalsRecalculated"
        }
      ],
      "command": {
        "$ref": "#/schemas/commands/CheckoutCart"
      },
      "aggregateRoot": {
        "$ref": "#/schemas/entities/Cart"
      },
      "readModels": [
        {
          "$ref": "#/schemas/queries/GetCartDetails"
        }
      ]
    },
    "StockAvailabilityVerified": {
      "event": "Stock Availability Verified",
      "role": "Inventory Service",
      "follows": [
        {
          "$ref": "#/domainEvents/CheckoutInitiated"
        }
      ],
      "command": {
        "$ref": "#/schemas/commands/VerifyStockAvailability"
      },
      "aggregateRoot": {
        "$ref": "#/schemas/entities/Cart"
      }
    },
    "CartCheckedOut": {
      "event": "Cart Checked Out",
      "role": "Cart Service",
      "follows": [
        {
          "$ref": "#/domainEvents/StockAvailabilityVerified"
        }
      ],
      "command": {
        "$ref": "#/schemas/commands/CompleteCheckout"
      },
      "aggregateRoot": {
        "$ref": "#/schemas/entities/Cart"
      },
      "readModels": [
        {
          "$ref": "#/schemas/queries/GetCartByCustomerID",
          "array": true
        }
      ]
    },
    "CheckoutFailed": {
      "event": "Checkout Failed",
      "role": "Cart Service",
      "follows": [
        {
          "$ref": "#/domainEvents/StockAvailabilityVerified"
        }
      ],
      "command": {
        "$ref": "#/schemas/commands/FailCheckout"
      },
      "aggregateRoot": {
        "$ref": "#/schemas/entities/Cart"
      },
      "readModels": [
        {
          "$ref": "#/schemas/queries/GetCartDetails"
        }
      ]
    },
    "OrderHandoffInitiated": {
      "event": "Order Handoff Initiated",
      "role": "Cart Service",
      "follows": [
        {
          "$ref": "#/domainEvents/CartCheckedOut"
        }
      ],
      "command": {
        "$ref": "#/schemas/commands/HandoffToOrderService"
      },
      "aggregateRoot": {
        "$ref": "#/schemas/entities/Cart"
      }
    }
  },
  "schemas": {
    "commands": {
      "CreateCart": {
        "type": "Command",
        "required": [
          "customerId",
          "currency"
        ],
        "fields": [
          {
            "name": "id",
            "hideInForm": true
          },
          {
            "name": "customerId",
            "hideInForm": false
          },
          {
            "name": "currency",
            "hideInForm": false
          }
        ]
      },
      "AddItemToCart": {
        "type": "Command",
        "required": [
          "cartId",
          "productId",
          "quantity"
        ],
        "fields": [
          {
            "name": "cartId",
            "hideInForm": false
          },
          {
            "name": "productId",
            "hideInForm": false
          },
          {
            "name": "quantity",
            "hideInForm": false
          }
        ]
      },
      "UpdateItemQuantity": {
        "type": "Command",
        "required": [
          "cartId",
          "cartItemId",
          "quantity"
        ],
        "fields": [
          {
            "name": "cartId",
            "hideInForm": false
          },
          {
            "name": "cartItemId",
            "hideInForm": false
          },
          {
            "name": "quantity",
            "hideInForm": false
          }
        ]
      },
      "RemoveItemFromCart": {
        "type": "Command",
        "required": [
          "cartId",
          "cartItemId"
        ],
        "fields": [
          {
            "name": "cartId",
            "hideInForm": false
          },
          {
            "name": "cartItemId",
            "hideInForm": false
          }
        ]
      },
      "ApplyCoupon": {
        "type": "Command",
        "required": [
          "cartId",
          "couponCode"
        ],
        "fields": [
          {
            "name": "cartId",
            "hideInForm": false
          },
          {
            "name": "couponCode",
            "hideInForm": false
          }
        ]
      },
      "CheckoutCart": {
        "type": "Command",
        "required": [
          "cartId"
        ],
        "fields": [
          {
            "name": "cartId",
            "hideInForm": false
          }
        ]
      },
      "FetchProductDetails": {
        "type": "Command",
        "required": [
          "cartId",
          "productId"
        ],
        "fields": [
          {
            "name": "cartId",
            "hideInForm": false
          },
          {
            "name": "productId",
            "hideInForm": false
          }
        ]
      },
      "RecalculateCartTotals": {
        "type": "Command",
        "required": [
          "cartId"
        ],
        "fields": [
          {
            "name": "cartId",
            "hideInForm": false
          }
        ]
      },
      "VerifyStockAvailability": {
        "type": "Command",
        "required": [
          "cartId"
        ],
        "fields": [
          {
            "name": "cartId",
            "hideInForm": false
          }
        ]
      },
      "CompleteCheckout": {
        "type": "Command",
        "required": [
          "cartId"
        ],
        "fields": [
          {
            "name": "cartId",
            "hideInForm": false
          }
        ]
      },
      "FailCheckout": {
        "type": "Command",
        "required": [
          "cartId",
          "reason"
        ],
        "fields": [
          {
            "name": "cartId",
            "hideInForm": false
          },
          {
            "name": "reason",
            "hideInForm": false
          }
        ]
      },
      "HandoffToOrderService": {
        "type": "Command",
        "required": [
          "cartId",
          "customerId"
        ],
        "fields": [
          {
            "name": "cartId",
            "hideInForm": false
          },
          {
            "name": "customerId",
            "hideInForm": false
          }
        ]
      }
    },
    "queries": {
      "GetCartDetails": {
        "type": "Query",
        "entity": {
          "$ref": "#/schemas/entities/Cart"
        },
        "fields": [
          {
            "name": "cartId",
            "isFilter": true
          },
          {
            "name": "customerId"
          },
          {
            "name": "status"
          },
          {
            "name": "currency"
          },
          {
            "name": "subtotal"
          },
          {
            "name": "discount"
          },
          {
            "name": "totalAmount"
          },
          {
            "name": "couponCode"
          },
          {
            "name": "cartItems",
            "relatedEntity": {
              "$ref": "#/schemas/entities/CartItem"
            },
            "fields": [
              {
                "name": "productId"
              },
              {
                "name": "productName"
              },
              {
                "name": "sku"
              },
              {
                "name": "quantity"
              },
              {
                "name": "unitPrice"
              },
              {
                "name": "subtotal"
              },
              {
                "name": "imageUrl"
              }
            ]
          },
          {
            "name": "createdAt"
          },
          {
            "name": "updatedAt"
          }
        ]
      },
      "GetCartByCustomerID": {
        "type": "Query",
        "entity": {
          "$ref": "#/schemas/entities/Cart"
        },
        "fields": [
          {
            "name": "customerId",
            "isFilter": true
          },
          {
            "name": "status",
            "isFilter": true
          },
          {
            "name": "cartId"
          },
          {
            "name": "totalAmount"
          },
          {
            "name": "createdAt"
          },
          {
            "name": "updatedAt"
          }
        ]
      },
      "GetCartSummary": {
        "type": "Query",
        "entity": {
          "$ref": "#/schemas/entities/Cart"
        },
        "fields": [
          {
            "name": "cartId",
            "isFilter": true
          },
          {
            "name": "itemCount"
          },
          {
            "name": "subtotal"
          },
          {
            "name": "discount"
          },
          {
            "name": "totalAmount"
          },
          {
            "name": "couponCode"
          },
          {
            "name": "currency"
          }
        ]
      }
    },
    "entities": {
      "Cart": {
        "type": "Entity",
        "boundedContext": "Shopping Cart",
        "required": [
          "id",
          "customerId",
          "status",
          "currency",
          "subtotal",
          "totalAmount",
          "createdAt",
          "updatedAt"
        ],
        "fields": [
          {
            "name": "id",
            "exampleData": [
              "cart-a1b2c3",
              "cart-d4e5f6",
              "cart-g7h8i9"
            ],
            "dataType": "string"
          },
          {
            "name": "customerId",
            "exampleData": [
              "cust-1001",
              "cust-2002",
              "cust-3003"
            ],
            "dataType": "string"
          },
          {
            "name": "status",
            "exampleData": [
              "active",
              "checked_out",
              "expired"
            ],
            "dataType": "string"
          },
          {
            "name": "currency",
            "exampleData": [
              "USD",
              "EUR",
              "GBP"
            ],
            "dataType": "string"
          },
          {
            "name": "subtotal",
            "exampleData": [
              "89.97",
              "249.50",
              "34.99"
            ],
            "dataType": "number"
          },
          {
            "name": "discount",
            "exampleData": [
              "0",
              "12.50",
              "5.00"
            ],
            "dataType": "number"
          },
          {
            "name": "totalAmount",
            "exampleData": [
              "89.97",
              "237.00",
              "29.99"
            ],
            "dataType": "number"
          },
          {
            "name": "couponCode",
            "exampleData": [
              "SAVE10",
              "WELCOME20"
            ],
            "dataType": "string"
          },
          {
            "name": "createdAt",
            "exampleData": [
              "2026-03-01T10:00:00Z",
              "2026-03-02T14:30:00Z",
              "2026-03-03T09:15:00Z"
            ],
            "dataType": "string"
          },
          {
            "name": "updatedAt",
            "exampleData": [
              "2026-03-01T10:05:00Z",
              "2026-03-02T15:00:00Z",
              "2026-03-03T09:20:00Z"
            ],
            "dataType": "string"
          },
          {
            "name": "expiresAt",
            "exampleData": [
              "2026-03-08T10:00:00Z",
              "2026-03-09T14:30:00Z",
              "2026-03-10T09:15:00Z"
            ],
            "dataType": "string"
          },
          {
            "name": "cartItems",
            "array": true,
            "exampleData": [],
            "relatedEntity": {
              "$ref": "#/schemas/entities/CartItem"
            },
            "dataType": "object"
          }
        ]
      },
      "CartItem": {
        "type": "Entity",
        "boundedContext": "Shopping Cart",
        "required": [
          "id",
          "productId",
          "productName",
          "sku",
          "quantity",
          "unitPrice",
          "subtotal"
        ],
        "fields": [
          {
            "name": "id",
            "exampleData": [
              "ci-001",
              "ci-002",
              "ci-003"
            ],
            "dataType": "string"
          },
          {
            "name": "productId",
            "exampleData": [
              "prod-5001",
              "prod-5002",
              "prod-5003"
            ],
            "dataType": "string"
          },
          {
            "name": "productName",
            "exampleData": [
              "Wireless Mouse",
              "USB-C Hub",
              "Laptop Stand"
            ],
            "dataType": "string"
          },
          {
            "name": "sku",
            "exampleData": [
              "WM-BLK-001",
              "USB-HUB-4P",
              "LS-ALU-ADJ"
            ],
            "dataType": "string"
          },
          {
            "name": "quantity",
            "exampleData": [
              "1",
              "3",
              "2"
            ],
            "dataType": "number"
          },
          {
            "name": "unitPrice",
            "exampleData": [
              "29.99",
              "49.99",
              "45.00"
            ],
            "dataType": "number"
          },
          {
            "name": "subtotal",
            "exampleData": [
              "29.99",
              "149.97",
              "90.00"
            ],
            "dataType": "number"
          },
          {
            "name": "imageUrl",
            "exampleData": [
              "https://cdn.example.com/wm-001.jpg",
              "https://cdn.example.com/hub-4p.jpg",
              "https://cdn.example.com/ls-adj.jpg"
            ],
            "dataType": "string"
          }
        ]
      }
    },
    "valueObjects": {
      "Coupon": {
        "type": "ValueObject",
        "boundedContext": "Shopping Cart",
        "required": [
          "code",
          "discountType",
          "discountValue"
        ],
        "fields": [
          {
            "name": "code",
            "exampleData": [
              "SAVE10",
              "WELCOME20",
              "SUMMER15"
            ],
            "dataType": "string"
          },
          {
            "name": "discountType",
            "exampleData": [
              "percentage",
              "fixed",
              "percentage"
            ],
            "dataType": "string"
          },
          {
            "name": "discountValue",
            "exampleData": [
              "10",
              "20",
              "15"
            ],
            "dataType": "number"
          },
          {
            "name": "minOrderAmount",
            "exampleData": [
              "50.00",
              "0",
              "75.00"
            ],
            "dataType": "number"
          }
        ]
      }
    }
  },
  "groups": [
    {
      "name": "Cart Management",
      "startSlotX": 0
    },
    {
      "name": "Promotions",
      "startSlotX": 5
    },
    {
      "name": "Checkout",
      "startSlotX": 7
    }
  ],
  "releases": []
}
